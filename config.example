# Copy to ~/.config/taildrop/config (chmod 600). Never commit the real thing.
# The Linux tailnet node that serves hosted shares.
TAILDROP_HOST=myserver
# Unprivileged account there; it may only run tnshare-host via sudo.
TAILDROP_HOST_SSH=taildrop@myserver.example.ts.net
# Private key for that account.
TAILDROP_HOST_KEY=$HOME/.ssh/taildrop_ed25519
